# Copy to .env (cp .env.example .env). .env is git-ignored - never commit real credentials.

# Kafka broker as seen from your laptop (docker compose maps it to localhost:9092).
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Leave empty to use the Postgres container from docker-compose.
# For the deployed dashboard, paste your Supabase *Session pooler* connection string, e.g.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Average trip events per second sent by the producer.
EVENTS_PER_SEC=2
